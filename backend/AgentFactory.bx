/**
 * AgentFactory - the orchestrator.
 *
 *   problem  --Architect-->  spec  --Builder-->  project  --QA-->  verdict
 *                             ^                                       |
 *                             +--------------- redesign --------------+   (<= maxRepairs)
 *
 * build( prompt )        full pipeline (needs a provider key for the Architect step)
 * buildFromSpec( spec )  skip the Architect — Builder + QA only (no key needed;
 *                        used by tests and by the frontend's "edit spec" flow)
 */
class accessors="true" {

	property name="repoRoot" type="string";
	property name="architect";
	property name="builder";
	property name="coder";
	property name="qa";
	property name="progress";

	function init(
		required string repoRoot,
		string provider    = "",
		string model       = "",
		string bxAgentsBin = "bxAgents"
	) {
		variables.repoRoot  = arguments.repoRoot;
		variables.architect = new backend.agents.ArchitectAgent( arguments.provider, arguments.model );
		variables.builder   = new backend.agents.BuilderAgent( arguments.repoRoot );
		variables.coder     = new backend.agents.CoderBuilderAgent( arguments.repoRoot, arguments.provider, arguments.model, arguments.bxAgentsBin );
		variables.qa        = new backend.agents.QAAgent( arguments.repoRoot, arguments.bxAgentsBin );
		variables.progress  = new backend.lib.ProgressReporter();
		return this;
	}

	/**
	 * Opt in to progress reporting for the UI's build bar. A setter rather than a
	 * constructor argument so generate.bxs / testPipeline.bxs / api/run.bxs keep
	 * working against the signature they already call.
	 */
	function withProgress( required any reporter ) {
		variables.progress = arguments.reporter;
		variables.coder.withProgress( arguments.reporter );
		return this;
	}

	/** @return report struct (see assemble()) */
	function build( required string problem, numeric maxRepairs = 1 ) {
		variables.progress.useLayout( "llm" );
		variables.progress.phase( "architect", "Architect — turning the problem into a spec" );
		var spec = variables.architect.design( arguments.problem );
		return runLoop( arguments.problem, spec, arguments.maxRepairs, true );
	}

	/** @return report struct — Builder + QA only, no LLM (also skips the agentic coder pass). */
	function buildFromSpec( required struct spec ) {
		variables.progress.useLayout( "spec" );
		variables.progress.phase( "prepare", "Reading the supplied spec" );
		var problem = arguments.spec.problem ?: "(spec supplied directly)";
		return runLoop( problem, arguments.spec, 0, false );
	}

	// ---------------------------------------------------------------- internals

	private function runLoop( string problem, struct spec, numeric maxRepairs, boolean useCoder = false ) {
		var attempts = [];
		var current  = arguments.spec;
		var attempt  = 0;

		while ( true ) {
			variables.progress.phase( "builder", "Builder — rendering the project files" );
			var built = variables.builder.build( current );

			variables.progress.phase( "qa", "QA — running bxAgents build" );
			var verdict = variables.qa.test( built.dir );

			// Best-effort: try to upgrade the honest stubs BuilderAgent just wrote into
			// real implementations. Only on the LLM path (buildFromSpec() has no key to
			// spend), and only once the structural QA above already passes - no point
			// asking the coder to fix a spec/template problem it didn't cause.
			if ( arguments.useCoder && verdict.verdict == "PASS" ) {
				variables.progress.phase( "coder", "Coder — writing real tool implementations" );
				verdict = variables.coder.implement( current, built.dir );
			}

			attempts.append( {
				"attempt"   : attempt,
				"slug"      : built.slug,
				"checkPass" : verdict.checkPass,
				"verdict"   : verdict.verdict,
				"checkLog"  : verdict.checkLog
			} );

			if ( verdict.verdict == "PASS" || attempt >= arguments.maxRepairs ) {
				variables.progress.phase( "finalize", "Packaging the generated project" );
				return assemble( arguments.problem, current, built, verdict, attempts );
			}

			attempt++;
			variables.progress.repair( attempt );
			current = variables.architect.redesign( arguments.problem, current, verdict.checkLog );
		}
	}

	private function assemble( string problem, struct spec, struct built, struct verdict, array attempts ) {
		var projectDir = arguments.built.dir;
		return {
			"problem"    : arguments.problem,
			"success"    : arguments.verdict.verdict == "PASS",
			"slug"       : arguments.built.slug,
			"spec"       : arguments.spec,
			"projectDir" : projectDir,
			"files"      : arguments.built.files.map( ( p ) => ({
				"path"    : p.replace( projectDir & "/", "", "one" ),
				"content" : fileRead( p )
			}) ),
			"attempts"   : arguments.attempts
		};
	}

}
