/**
 * Validator - proves a generated project is real:
 *   check()    -> `boxlang check` passes (syntax / parse)
 *   mockRun()  -> run.bxs completes under the mock provider (no API key, no throw)
 *   liveRun()  -> run.bxs completes against the real provider (needs an API key)
 *
 * Shells out via java.lang.ProcessBuilder. Used by backend/agents/QAAgent.bx and web/api.
 */
class accessors="true" {

	property name="repoRoot"   type="string";
	property name="boxlangBin" type="string";

	function init( required string repoRoot, string boxlangBin = "boxlang" ) {
		variables.repoRoot   = arguments.repoRoot;
		variables.boxlangBin = arguments.boxlangBin;
		return this;
	}

	/** @return { passed:boolean, output:string } */
	function check( required string projectDir ) {
		return run( [ variables.boxlangBin, "check", "--source", arguments.projectDir ], 60 );
	}

	/** @return { passed:boolean, output:string } */
	function mockRun( required string projectDir ) {
		var result = run( [
			variables.boxlangBin,
			"--bx-config", variables.repoRoot & "/boxlang.json",
			arguments.projectDir & "/run.bxs",
			"--mock"
		], 90 );
		result.passed = result.passed
			&& result.output contains "MOCK OK"
			&& !( result.output contains "[agent error]" );
		return result;
	}

	/** @return { passed:boolean, output:string } - real provider call, no --mock */
	function liveRun( required string projectDir ) {
		var result = run( [
			variables.boxlangBin,
			"--bx-config", variables.repoRoot & "/boxlang.json",
			arguments.projectDir & "/run.bxs"
		], 120 );
		result.passed = result.passed && !( result.output contains "[agent error]" );
		return result;
	}

	// ---------------------------------------------------------------- internals

	private function run( array argv, numeric timeout ) {
		try {
			var pb = new java:java.lang.ProcessBuilder( argv.map( ( x ) => toString( x ) ) );
			pb.directory( new java:java.io.File( variables.repoRoot ) );
			pb.redirectErrorStream( true );

			var proc   = pb.start();
			var output = new java:java.lang.String( proc.getInputStream().readAllBytes(), "UTF-8" );
			var exited = proc.waitFor(
				arguments.timeout,
				createObject( "java", "java.util.concurrent.TimeUnit" ).SECONDS
			);
			if ( !exited ) {
				proc.destroyForcibly();
				return { "passed": false, "output": "timed out after " & arguments.timeout & "s" };
			}
			return { "passed": proc.exitValue() == 0, "output": toString( output ) };
		} catch ( any e ) {
			return { "passed": false, "output": e.message };
		}
	}

}
