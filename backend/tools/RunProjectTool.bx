/**
 * RunProjectTool - runs `bxAgents build` on a project and returns the verdict.
 * Wraps backend/agents/QAAgent.bx so the agentic Builder can test its own output
 * mid-generation.
 */
class accessors="true" {

	property name="qa";
	property name="projectDir" type="string";

	function init( required string repoRoot, required string projectDir, string bxAgentsBin = "bxAgents" ) {
		variables.qa         = new backend.agents.QAAgent( arguments.repoRoot, arguments.bxAgentsBin );
		variables.projectDir = arguments.projectDir;
		return this;
	}

	function toTool() {
		return aiTool(
			"runProject",
			"Run `bxAgents build` on the current project. Returns a JSON verdict: "
			& "checkPass, verdict, and a log tail.",
			() => jsonSerialize( variables.qa.test( variables.projectDir ) )
		);
	}

}
