/**
 * @@AGENT_NAME@@ — generated by Agent Factory
 *
 * Problem this agent was built for:
 *   @@PROBLEM@@
 *
 * Run:  ./bx.ps1 generated/@@SLUG@@/run.bxs
 * Mock provider (no API key, deterministic):
 *       ./bx.ps1 generated/@@SLUG@@/run.bxs --mock
 */
useMock = cliGetArgs().options.mock ?: false;

// ----------------------------------------------------------------------------
// Tools
// ----------------------------------------------------------------------------
@@TOOL_DEFS@@

// ----------------------------------------------------------------------------
// Agent
// ----------------------------------------------------------------------------
@@AGENT_VAR@@ = aiAgent(
	name         = "@@AGENT_NAME@@",
	description  = @@ROLE@@,
	instructions = @@INSTRUCTIONS@@,
	model        = useMock ? aiModel( provider = "mock" ) : aiModel(),
	tools        = [ @@TOOL_LIST@@ ]
);

// ----------------------------------------------------------------------------
// Demo run
// ----------------------------------------------------------------------------
examplePrompts = @@EXAMPLE_PROMPTS@@;

// In --mock mode, feed the pipeline a scripted reply so the whole agent loop
// runs offline with no API key (used by the Factory's validation step).
runOptions = useMock
	? { providerOptions: { responses: examplePrompts.map( ( p ) => "MOCK OK — @@AGENT_NAME@@ is wired correctly. No LLM was called." ) } }
	: {};

for ( prompt in examplePrompts ) {
	println( "──────────────────────────────────────────────────────────────" );
	println( "▶ " & prompt );
	println( "" );
	try {
		println( @@AGENT_VAR@@.run( prompt, {}, runOptions ) );
	} catch ( any e ) {
		println( "[agent error] " & e.message );
	}
	println( "" );
}
