/**
 * QAAgent - tests a generated BxAgents project and returns a verdict.
 *
 *   check : `bxAgents build` (discovery + validation + codegen) - free, no API key.
 *
 * PASS only if that holds. On FAIL the orchestrator hands the output back to
 * ArchitectAgent.redesign() for another attempt.
 *
 * (There is no free functional smoke test in this pipeline - BxAgents' own `test`
 * command needs TestBox installed under tests/, which needs a working `box` CLI.
 * A real functional check is available via Validator.liveRun(), but that spends a
 * real provider call - see AgentFactory / CoderBuilderAgent for where that's used.)
 */
class accessors="true" {

	property name="validator";

	function init( required string repoRoot, string bxAgentsBin = "bxAgents" ) {
		variables.validator = new backend.lib.Validator( arguments.repoRoot, arguments.bxAgentsBin );
		return this;
	}

	/**
	 * @projectDir  Absolute path to a generated project folder.
	 * @return { checkPass, verdict, checkLog }
	 */
	function test( required string projectDir ) {
		var check = variables.validator.check( arguments.projectDir );

		return {
			"checkPass" : check.passed,
			"verdict"   : check.passed ? "PASS" : "FAIL",
			"checkLog"  : check.output.right( 1500 )
		};
	}

}
