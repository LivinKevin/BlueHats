/**
 * QAAgent - tests a generated project and returns a verdict.
 *
 *   check   : `boxlang check` (syntax / parse)
 *   mockRun : run.bxs completes under bx-ai's mock provider (no key, no throw)
 *
 * PASS only if both hold. On FAIL the orchestrator hands the output back to
 * ArchitectAgent.redesign() for another attempt.
 */
class accessors="true" {

	property name="validator";

	function init( required string repoRoot, string boxlangBin = "boxlang" ) {
		variables.validator = new backend.lib.Validator( arguments.repoRoot, arguments.boxlangBin );
		return this;
	}

	/**
	 * @projectDir  Absolute path to a generated project folder.
	 * @return { checkPass, mockPass, verdict, checkLog, mockLog }
	 */
	function test( required string projectDir ) {
		var check = variables.validator.check( arguments.projectDir );
		var mock  = check.passed
			? variables.validator.mockRun( arguments.projectDir )
			: { "passed": false, "output": "skipped (check failed)" };

		return {
			"checkPass" : check.passed,
			"mockPass"  : mock.passed,
			"verdict"   : ( check.passed && mock.passed ) ? "PASS" : "FAIL",
			"checkLog"  : check.output.right( 1500 ),
			"mockLog"   : mock.output.right( 1500 )
		};
	}

}
