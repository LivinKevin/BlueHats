/**
 * ComplexityProfiler agent - measure, diagnose, recommend.
 *
 * Run:  boxlang src/agent.bxs profiler/examples/sum_squares_list.py
 * Needs: a provider API key (see boxlang.json).
 */
root   = getDirectoryFromPath( getCurrentTemplatePath() ).reReplace( "[\\/]src[\\/]$", "" );
target = ( server.system.parameters ?: [] ).len() ? server.system.parameters[ 1 ]
                                                  : "profiler/examples/sum_squares_list.py";

profileTool = new src.ProfileTool( projectRoot = root ).toTool();

agent = aiAgent(
	name        = "ComplexityProfiler",
	description  = "Measures empirical time and space complexity of Python functions and recommends improvements.",
	instructions = "
		You are a performance analyst. Given a Python target file:
		1. Call profile_complexity with a sensible spread of increasing input sizes
		   (for recursion-heavy code keep sizes small).
		2. Read the measured runtime, peak memory, and fitted complexity per axis.
		3. State plainly whether the function is TIME-bound or SPACE-bound, citing the measured numbers.
		4. Name the specific pattern causing it: nested loop, full list materialisation,
		   naive recursion, membership scan inside a loop, repeated sort, string concat in a loop,
		   or an unbounded cache.
		5. Recommend ONE concrete fix and state its expected effect on each axis.
		Be concise. Always cite measured numbers. Never claim a complexity you did not measure.
	",
	tools = [ profileTool ]
);

println( "Analysing: " & target & chr(10) );
println( agent.run( "Profile and analyse this file: " & target ) );
