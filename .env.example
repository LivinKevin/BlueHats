# Copy to .env and fill in the key you were given. .env is gitignored.
# The bx.ps1 / bx.sh wrappers load this file (and ~/.box.env) before running BoxLang.

# Whichever provider matches "provider" in boxlang.json needs its key set here.
OPENROUTER_API_KEY=your-api-key
CLAUDE_API_KEY=your-api-key
OPENAI_API_KEY=your-api-key
GEMINI_API_KEY=your-api-key
GROQ_API_KEY=your-api-key
DEEPSEEK_API_KEY=your-api-key
MISTRAL_API_KEY=your-api-key

# Optional: point BoxLang at a custom config path (the wrappers already pass
# --bx-config, so this is only for running the raw `boxlang` CLI yourself).
# BOXLANG_CONFIG=./boxlang.json
